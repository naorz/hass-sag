{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sag/utils": ["src/utils"],
      "@sag/menu": ["src/menu"],
      "@sag/types": ["src/types.ts"],
      "@sag/schemas": ["src/schemas"],
      "@sag/core": ["src/core"],
      "@sag/providers": ["src/providers"],
      "@sag/topics": ["src/topics"]
    },
    "types": ["node", "zx"]
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
